# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin password gate
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=random-long-string

# Storefront URL (product public links)
NEXT_PUBLIC_SITE_URL=https://rovik.ltd
# This admin app URL (Track order links in email)
NEXT_PUBLIC_TRACK_URL=https://admin.rovik.ltd

# Optional: Resend (required to email the Track order link)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Rovik <orders@rovik.ltd>

# Optional: DB insert webhook → /api/webhooks/new-order (no CallMeBot in this app)
ORDER_WEBHOOK_SECRET=
